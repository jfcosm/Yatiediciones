---
const workshops = [
  {
    title: "Cuentacuentos y Mediación Lector",
    desc: "Sesiones narrativas dinámicas donde leemos relatos originarios, interactuamos con títeres o telares y abrimos la conversación sobre nuestras raíces.",
    duration: "45-60 min",
    audience: "Educación Parvularia y Básica",
    icon: "🗣️"
  },
  {
    title: "Taller de Autoedición y Creación de Libros",
    desc: "Un taller práctico donde los alumnos escriben sus propios microrrelatos familiares y arman un mini-libro coloreado e ilustrado por ellos mismos.",
    duration: "90 min (2 sesiones)",
    audience: "Enseñanza Básica y Media",
    icon: "✍️"
  },
  {
    title: "Clubes de Lectura y Diálogo Intercultural",
    desc: "Espacios de lectura comunitaria guiados por Carmen Clavijo para reflexionar sobre mitología diaguita, mapuche y andina, promoviendo el respeto a la diversidad.",
    duration: "Semanal",
    audience: "Docentes, padres y comunidad",
    icon: "🛖"
  }
];
---
<section id="services" class="py-24 bg-hueso/30 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Header -->
    <div class="text-center max-w-2xl mx-auto mb-16 space-y-4">
      <span class="text-sm font-bold uppercase tracking-widest text-verde bg-verde/10 px-4 py-1.5 rounded-full">Talleres e Intervenciones</span>
      <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl font-extrabold text-azul">
        Llevamos las historias a tu colegio y comunidad
      </h2>
      <p class="text-base sm:text-lg text-azul/70 font-medium">
        Fomentamos la lectoescritura interactiva mediante actividades pedagógicas con pertinencia cultural regional.
      </p>
    </div>

    <!-- Workshops Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 mb-16">
      {workshops.map((workshop) => (
        <div class="bg-white rounded-3xl p-8 border border-azul/5 shadow-sm hover:shadow-lg transition-all duration-300 flex flex-col justify-between group">
          <div class="space-y-6">
            <span class="text-4xl block w-14 h-14 rounded-2xl bg-verde/10 flex items-center justify-center text-center group-hover:scale-110 transition-transform">
              {workshop.icon}
            </span>
            <div class="space-y-2">
              <h3 class="font-display text-xl font-extrabold text-azul group-hover:text-verde transition-colors">{workshop.title}</h3>
              <p class="text-sm text-azul/70 font-medium leading-relaxed">{workshop.desc}</p>
            </div>
          </div>

          <!-- Metadata info -->
          <div class="pt-6 mt-6 border-t border-azul/5 grid grid-cols-2 gap-2 text-xs font-bold text-azul/60 uppercase tracking-wider">
            <div>
              <span class="block text-[10px] text-azul/40">Duración:</span>
              <span>{workshop.duration}</span>
            </div>
            <div>
              <span class="block text-[10px] text-azul/40">Público:</span>
              <span>{workshop.audience}</span>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- CTA Box -->
    <div class="max-w-4xl mx-auto bg-azul rounded-3xl p-8 md:p-12 text-white border border-azul/20 shadow-xl relative overflow-hidden text-center space-y-6">
      <!-- Backdrop design circles -->
      <div class="absolute -top-10 -right-10 w-40 h-40 bg-white/5 rounded-full blur-lg"></div>
      
      <h3 class="font-display text-2xl sm:text-3xl font-extrabold">¿Quieres realizar un taller en tu establecimiento?</h3>
      <p class="text-white/80 max-w-xl mx-auto font-medium">
        Adaptamos los talleres a las necesidades curriculares de tu colegio. Trabajamos con fondos SEP y apoyos municipales.
      </p>
      
      <div class="pt-2">
        <a 
          href="#contact" 
          class="inline-block px-10 py-4 bg-terracota text-white font-extrabold rounded-full hover:bg-ocre hover:scale-105 active:scale-95 transition-all shadow-md shadow-terracota/20 hover:shadow-ocre/20 text-base"
        >
          Cotizar un taller para tu colegio
        </a>
      </div>
    </div>

  </div>
</section>
