---
import { translations } from '../i18n/translations';

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const activeLang = lang || 'es';
const t = translations[activeLang as keyof typeof translations] || translations.es;

const icons = ["🗣️", "✍️", "🛖"];
const workshopImages = [
  "/images/taller1.JPG",
  "/images/taller2.JPG",
  "/images/taller3.JPG"
];
---
<section id="services" class="py-24 bg-hueso/30 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Header -->
    <div class="text-center max-w-2xl mx-auto mb-16 space-y-4">
      <span class="text-sm font-bold uppercase tracking-widest text-verde bg-verde/10 px-4 py-1.5 rounded-full">{t.workshops.tag}</span>
      <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl font-extrabold text-azul">
        {t.workshops.title}
      </h2>
      <p class="text-base sm:text-lg text-azul/70 font-medium">
        {t.workshops.desc}
      </p>
    </div>

    <!-- Workshops Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 mb-16">
      {t.workshops.items.map((workshop, idx) => (
        <div class="bg-white rounded-3xl p-6 border border-azul/5 shadow-sm hover:shadow-lg transition-all duration-300 flex flex-col justify-between group">
          <div class="space-y-6 text-start">
            <!-- Image Header -->
            <div class="relative h-48 w-full rounded-2xl overflow-hidden bg-hueso border border-azul/5">
              <img 
                src={workshopImages[idx]} 
                alt={workshop.title} 
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 ease-out"
                loading="lazy"
              />
              <!-- Emoji overlay -->
              <span class="absolute bottom-3 right-3 dir-rtl:left-3 dir-rtl:right-auto w-10 h-10 rounded-xl bg-white/95 backdrop-blur-sm flex items-center justify-center text-xl shadow-md border border-azul/5">
                {icons[idx] || "📚"}
              </span>
            </div>
            <div class="space-y-2">
              <h3 class="font-display text-xl font-extrabold text-azul group-hover:text-verde transition-colors">{workshop.title}</h3>
              <p class="text-sm text-azul/70 font-medium leading-relaxed">{workshop.desc}</p>
            </div>
          </div>

          <!-- Metadata info -->
          <div class="pt-6 mt-6 border-t border-azul/5 grid grid-cols-2 gap-2 text-xs font-bold text-azul/60 uppercase tracking-wider text-start">
            <div>
              <span class="block text-[10px] text-azul/40">Info / Time:</span>
              <span>{workshop.duration}</span>
            </div>
            <div>
              <span class="block text-[10px] text-azul/40">Audience:</span>
              <span>{workshop.audience}</span>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- CTA Box -->
    <div class="max-w-4xl mx-auto bg-azul rounded-3xl p-8 md:p-12 text-white border border-azul/20 shadow-xl relative overflow-hidden text-center space-y-6">
      <!-- Backdrop design circles -->
      <div class="absolute -top-10 -right-10 w-40 h-40 bg-white/5 rounded-full blur-lg"></div>
      
      <h3 class="font-display text-2xl sm:text-3xl font-extrabold">{t.workshops.ctaTitle}</h3>
      <p class="text-white/80 max-w-xl mx-auto font-medium">
        {t.workshops.ctaDesc}
      </p>
      
      <div class="pt-2">
        <a 
          href="#contact" 
          class="inline-block px-10 py-4 bg-terracota text-white font-extrabold rounded-full hover:bg-ocre hover:scale-105 active:scale-95 transition-all shadow-md shadow-terracota/20 hover:shadow-ocre/20 text-base"
        >
          {t.workshops.ctaBtn}
        </a>
      </div>
    </div>

  </div>
</section>
