---
interface Props {
  title: string;
  subtitle: string;
  description: string;
  imageSrc: string;
  tags: string[];
  ageGroup: string;
  ctaText: string;
}

const { title, subtitle, description, imageSrc, tags, ageGroup, ctaText } = Astro.props;
---
<div class="group bg-white rounded-3xl overflow-hidden border border-azul/5 shadow-md hover:shadow-xl transition-all duration-300 flex flex-col h-full transform hover:-translate-y-1">
  
  <!-- Image Wrapper -->
  <div class="relative pt-[100%] overflow-hidden bg-hueso border-b border-azul/5">
    <img 
      src={imageSrc} 
      alt={`Portada del libro ${title}`} 
      class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 ease-out"
      loading="lazy"
    />
    <!-- Age tag overlay -->
    <span class="absolute top-4 right-4 dir-rtl:left-4 dir-rtl:right-auto bg-azul/90 backdrop-blur-sm text-hueso text-xs font-bold px-3 py-1 rounded-full border border-hueso/20 shadow-md">
      {ageGroup}
    </span>
  </div>

  <!-- Content -->
  <div class="p-6 flex-grow flex flex-col justify-between text-start">
    <div class="space-y-3">
      <!-- Tags -->
      <div class="flex flex-wrap gap-1.5">
        {tags.map((tag) => (
          <span class="bg-verde/10 text-verde text-[11px] font-extrabold px-2.5 py-0.5 rounded-full uppercase tracking-wider">
            {tag}
          </span>
        ))}
      </div>

      <!-- Title & Subtitle -->
      <div>
        <h3 class="font-display text-xl font-extrabold text-azul group-hover:text-terracota transition-colors leading-snug">
          {title}
        </h3>
        <p class="text-xs text-azul/60 font-bold tracking-wide uppercase mt-0.5">{subtitle}</p>
      </div>

      <!-- Description -->
      <p class="text-sm text-azul/70 font-medium leading-relaxed line-clamp-3">
        {description}
      </p>
    </div>

    <!-- Action Button -->
    <div class="pt-6 mt-auto">
      <a 
        href="#contact" 
        class="block w-full text-center py-3 px-4 bg-hueso hover:bg-terracota text-azul hover:text-white font-bold rounded-xl transition-all border border-azul/10 hover:border-terracota shadow-sm active:scale-95 text-sm"
      >
        {ctaText}
      </a>
    </div>
  </div>
</div>
