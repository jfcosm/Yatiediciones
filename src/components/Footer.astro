---
import { translations } from '../i18n/translations';

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const activeLang = lang || 'es';
const t = translations[activeLang as keyof typeof translations] || translations.es;
---
<footer id="contact" class="bg-azul text-white pt-24 pb-12 relative overflow-hidden">
  
  <!-- Subtle top wave divider -->
  <div class="absolute top-0 left-0 w-full overflow-hidden leading-none rotate-180">
    <svg viewBox="0 0 1200 120" preserveAspectRatio="none" class="relative block w-full h-8 text-hueso/10 fill-current">
      <path d="M321.39,56.44c58-10.79,114.16-30.13,172-41.86,82.39-16.72,168.19-17.73,250.45-.39C823.78,31,906.67,72,985.66,92.83c70.05,18.48,146.53,26.09,214.34,3V120H0V0C26.9,8.75,57.05,18.3,87.43,26.75,170.82,50,250.41,69.57,321.39,56.44Z"></path>
    </svg>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Contact Form & Info Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 pb-20 border-b border-white/10">
      
      <!-- Contact Info (Left on Desktop) -->
      <div class="lg:col-span-5 space-y-8 text-start">
        <div class="space-y-4">
          <span class="text-xs font-bold uppercase tracking-widest text-ocre">{t.footer.contactTag}</span>
          <h2 class="font-display text-3xl sm:text-4xl font-extrabold leading-tight">
            {t.footer.contactTitle}
          </h2>
          <p class="text-white/70 font-medium">
            {t.footer.contactDesc}
          </p>
        </div>

        <div class="space-y-6">
          <div class="flex items-start gap-4">
            <span class="flex-shrink-0 flex items-center justify-center w-10 h-10 rounded-xl bg-white/10 text-lg">📍</span>
            <div>
              <h4 class="font-bold text-white text-base">{t.footer.contactLocLabel}</h4>
              <p class="text-sm text-white/70">La Serena / Coquimbo, Región de Coquimbo, Chile</p>
            </div>
          </div>
          <div class="flex items-start gap-4">
            <span class="flex-shrink-0 flex items-center justify-center w-10 h-10 rounded-xl bg-white/10 text-lg">📧</span>
            <div>
              <h4 class="font-bold text-white text-base">{t.footer.contactMailLabel}</h4>
              <a href="mailto:contacto@yatiediciones.cl" class="text-sm text-ocre hover:underline">contacto@yatiediciones.cl</a>
            </div>
          </div>
          <div class="flex items-start gap-4">
            <span class="flex-shrink-0 flex items-center justify-center w-10 h-10 rounded-xl bg-white/10 text-lg">📞</span>
            <div>
              <h4 class="font-bold text-white text-base">{t.footer.contactPhoneLabel}</h4>
              <a href="tel:+56912345678" class="text-sm text-white/70 hover:text-white transition-colors">+56 9 1234 5678</a>
            </div>
          </div>
        </div>

        <!-- Social Media Badge -->
        <div class="p-6 rounded-2xl bg-white/5 border border-white/10">
          <span class="block text-xs font-bold uppercase tracking-wider text-white/60 mb-3">{t.footer.contactFollow}</span>
          <div class="flex gap-4">
            <a href="#" class="w-10 h-10 rounded-full bg-white/10 hover:bg-terracota hover:scale-105 active:scale-95 transition-all flex items-center justify-center font-bold text-sm">IG</a>
            <a href="#" class="w-10 h-10 rounded-full bg-white/10 hover:bg-terracota hover:scale-105 active:scale-95 transition-all flex items-center justify-center font-bold text-sm">FB</a>
            <a href="#" class="w-10 h-10 rounded-full bg-white/10 hover:bg-terracota hover:scale-105 active:scale-95 transition-all flex items-center justify-center font-bold text-sm">YT</a>
          </div>
        </div>
      </div>

      <!-- Lead Capture Form (Right on Desktop) -->
      <div class="lg:col-span-7 bg-white/5 p-8 rounded-3xl border border-white/10 relative text-start">
        <h3 class="font-display text-2xl font-bold mb-6">{t.footer.formTitle}</h3>
        
        <form class="space-y-5" id="lead-form">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div class="space-y-2">
              <label for="name" class="block text-xs font-bold uppercase tracking-wider text-white/70">{t.footer.formName}</label>
              <input 
                type="text" 
                id="name" 
                required 
                placeholder={t.footer.formNamePlace} 
                class="w-full bg-white/10 border border-white/10 rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-ocre focus:ring-1 focus:ring-ocre text-white placeholder-white/30"
              />
            </div>
            <div class="space-y-2">
              <label for="email" class="block text-xs font-bold uppercase tracking-wider text-white/70">{t.footer.formEmail}</label>
              <input 
                type="email" 
                id="email" 
                required 
                placeholder={t.footer.formEmailPlace} 
                class="w-full bg-white/10 border border-white/10 rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-ocre focus:ring-1 focus:ring-ocre text-white placeholder-white/30"
              />
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div class="space-y-2">
              <label for="role" class="block text-xs font-bold uppercase tracking-wider text-white/70">{t.footer.formRole}</label>
              <select 
                id="role" 
                class="w-full bg-white/10 border border-white/15 rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-ocre text-white appearance-none cursor-pointer"
                style="background-image: url('data:image/svg+xml;utf8,<svg xmlns=%22http://www.w3.org/2000/svg%22 width=%2212%22 height=%226%22 fill=%22white%22><polygon points=%220,0 12,0 6,6%22/></svg>'); background-position: right 1rem center; background-repeat: no-repeat;"
              >
                <option value="padre" class="bg-azul">{t.footer.roleParent}</option>
                <option value="docente" class="bg-azul">{t.footer.roleTeacher}</option>
                <option value="colegio" class="bg-azul">{t.footer.roleSchool}</option>
                <option value="otro" class="bg-azul">{t.footer.roleOther}</option>
              </select>
            </div>
            <div class="space-y-2">
              <label for="interest" class="block text-xs font-bold uppercase tracking-wider text-white/70">{t.footer.formInterest}</label>
              <select 
                id="interest" 
                class="w-full bg-white/10 border border-white/15 rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-ocre text-white appearance-none cursor-pointer"
                style="background-image: url('data:image/svg+xml;utf8,<svg xmlns=%22http://www.w3.org/2000/svg%22 width=%2212%22 height=%226%22 fill=%22white%22><polygon points=%220,0 12,0 6,6%22/></svg>'); background-position: right 1rem center; background-repeat: no-repeat;"
              >
                <option value="comprar" class="bg-azul">{t.footer.interestBuy}</option>
                <option value="taller" class="bg-azul">{t.footer.interestWorkshop}</option>
                <option value="accesorios" class="bg-azul">{t.footer.interestAcc}</option>
                <option value="otro" class="bg-azul">{t.footer.interestOther}</option>
              </select>
            </div>
          </div>

          <div class="space-y-2">
            <label for="message" class="block text-xs font-bold uppercase tracking-wider text-white/70">{t.footer.formMsg}</label>
            <textarea 
              id="message" 
              rows="4" 
              required
              placeholder={t.footer.formMsgPlace} 
              class="w-full bg-white/10 border border-white/10 rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-ocre focus:ring-1 focus:ring-ocre text-white placeholder-white/30 resize-none"
            ></textarea>
          </div>

          <button 
            type="submit" 
            class="w-full py-4 px-6 bg-terracota text-white font-extrabold rounded-xl hover:bg-ocre transition-all shadow-md active:scale-98 text-sm cursor-pointer"
          >
            {t.footer.formBtn}
          </button>
        </form>
      </div>

    </div>

    <!-- Footer Bottom Brand Bar -->
    <div class="pt-12 flex flex-col md:flex-row justify-between items-center gap-6">
      
      <!-- Brand Logo / Name -->
      <a href="#" class="flex items-center space-x-3">
        <img 
          src="/images/logo_yatiediciones.png" 
          alt="Yatiediciones" 
          class="h-10 w-10 object-contain rounded-full border border-white/20"
        />
        <div class="flex flex-col text-start">
          <span class="font-display text-lg font-bold tracking-wide text-white">Yatiediciones</span>
          <span class="text-[9px] uppercase tracking-widest text-ocre font-bold -mt-1">{t.footer.slogan}</span>
        </div>
      </a>

      <!-- Credits / Copyright -->
      <div class="text-center md:text-right dir-rtl:text-left text-xs text-white/40 space-y-1">
        <p>&copy; {new Date().getFullYear()} Yatiediciones. {t.footer.copyright}</p>
        <p>{t.footer.credit}</p>
      </div>

    </div>

  </div>
</footer>

<script define:vars={{ alertMessage: t.footer.alertSuccess }}>
  const form = document.getElementById('lead-form');
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    alert(alertMessage);
    form.reset();
  });
</script>
