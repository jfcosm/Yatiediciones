---
import { translations } from '../i18n/translations';
import { booksTranslations } from '../i18n/books';
import BookCard from './BookCard.astro';

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const activeLang = lang || 'es';
const t = translations[activeLang as keyof typeof translations] || translations.es;
const bt = booksTranslations[activeLang as keyof typeof booksTranslations] || booksTranslations.es;

const books = [
  {
    title: bt.yati_magic.title,
    subtitle: bt.yati_magic.subtitle,
    description: bt.yati_magic.description,
    imageSrc: "/images/la_magia_de_la_yati.png",
    tags: bt.yati_magic.tags,
    ageGroup: bt.yati_magic.age
  },
  {
    title: bt.zenon_coloring.title,
    subtitle: bt.zenon_coloring.subtitle,
    description: bt.zenon_coloring.description,
    imageSrc: "/images/zenon_coloring_cover.png",
    tags: bt.zenon_coloring.tags,
    ageGroup: bt.zenon_coloring.age
  },
  {
    title: bt.cuaderno_1.title,
    subtitle: bt.cuaderno_1.subtitle,
    description: bt.cuaderno_1.description,
    imageSrc: "/images/cuaderno_aprendizaje_1.png",
    tags: bt.cuaderno_1.tags,
    ageGroup: bt.cuaderno_1.age
  },
  {
    title: bt.educador_tradicional.title,
    subtitle: bt.educador_tradicional.subtitle,
    description: bt.educador_tradicional.description,
    imageSrc: "/images/educador_tradicional.png",
    tags: bt.educador_tradicional.tags,
    ageGroup: bt.educador_tradicional.age
  },
  {
    title: bt.diario_de_kurmi.title,
    subtitle: bt.diario_de_kurmi.subtitle,
    description: bt.diario_de_kurmi.description,
    imageSrc: "/images/diario_de_kurmi.jpg",
    tags: bt.diario_de_kurmi.tags,
    ageGroup: bt.diario_de_kurmi.age
  },
  {
    title: bt.cuaderno_2.title,
    subtitle: bt.cuaderno_2.subtitle,
    description: bt.cuaderno_2.description,
    imageSrc: "/images/cuaderno_aprendizaje_2.jpeg",
    tags: bt.cuaderno_2.tags,
    ageGroup: bt.cuaderno_2.age
  },
  {
    title: bt.secretos_awicha.title,
    subtitle: bt.secretos_awicha.subtitle,
    description: bt.secretos_awicha.description,
    imageSrc: "/images/secretos_de_awicha.jpg",
    tags: bt.secretos_awicha.tags,
    ageGroup: bt.secretos_awicha.age
  },
  {
    title: bt.cuentos_zenon.title,
    subtitle: bt.cuentos_zenon.subtitle,
    description: bt.cuentos_zenon.description,
    imageSrc: "/images/cuentos_andinos_zenon.png",
    tags: bt.cuentos_zenon.tags,
    ageGroup: bt.cuentos_zenon.age
  }
];
---
<section id="catalog" class="py-24 bg-hueso/50 relative overflow-hidden">
  
  <!-- Background design shapes -->
  <div class="absolute bottom-20 right-0 dir-rtl:left-0 dir-rtl:right-auto w-80 h-80 bg-terracota/5 rounded-full blur-2xl pointer-events-none"></div>
  <div class="absolute top-10 left-10 dir-rtl:right-10 dir-rtl:left-auto w-64 h-64 bg-verde/5 rounded-full blur-2xl pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative">
    
    <!-- Title Section -->
    <div class="text-center max-w-2xl mx-auto mb-16 space-y-4">
      <span class="text-sm font-bold uppercase tracking-widest text-verde bg-verde/10 px-4 py-1.5 rounded-full">{t.catalog.tag}</span>
      <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl font-extrabold text-azul">
        {t.catalog.title}
      </h2>
      <p class="text-base sm:text-lg text-azul/70 font-medium">
        {t.catalog.desc}
      </p>
    </div>

    <!-- Books Grid (expanded to 4 cols on extra large screens) -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-8 lg:gap-10">
      {books.map((book) => (
        <BookCard {...book} ctaText={t.catalog.bookCta} />
      ))}
    </div>

    <!-- Visual Banner (Ready to color) -->
    <div class="mt-20 relative rounded-3xl bg-gradient-to-r from-terracota via-terracota to-ocre text-white p-8 md:p-12 shadow-xl overflow-hidden group">
      
      <!-- Decorative circles -->
      <div class="absolute top-0 right-0 dir-rtl:left-0 dir-rtl:right-auto w-64 h-64 bg-white/5 rounded-full -mr-20 dir-rtl:-ml-20 -mt-20 blur-xl"></div>
      <div class="absolute bottom-0 left-0 dir-rtl:right-0 dir-rtl:left-auto w-48 h-48 bg-white/5 rounded-full -ml-20 dir-rtl:-mr-20 -mb-20 blur-xl"></div>

      <div class="relative grid grid-cols-1 lg:grid-cols-12 gap-8 items-center text-start">
        <!-- Text Column -->
        <div class="lg:col-span-8 space-y-4">
          <div class="inline-flex items-center gap-2 bg-white/20 border border-white/25 px-4 py-1 rounded-full text-xs font-bold uppercase tracking-widest">
            {t.catalog.bannerTag}
          </div>
          <h3 class="font-display text-2xl sm:text-3xl md:text-4xl font-extrabold leading-tight">
            {t.catalog.bannerTitle}
          </h3>
          <p class="text-white/90 text-base md:text-lg font-medium leading-relaxed max-w-3xl">
            {t.catalog.bannerDesc}
          </p>
        </div>

        <!-- Button Column -->
        <div class="lg:col-span-4 lg:flex lg:justify-end">
          <a 
            href="#contact" 
            class="inline-block w-full lg:w-auto text-center px-8 py-4 bg-azul text-white font-extrabold rounded-full hover:bg-hueso hover:text-azul hover:scale-105 active:scale-95 transition-all shadow-lg shadow-azul/20 text-base md:text-lg"
          >
            {t.catalog.bannerCta}
          </a>
        </div>
      </div>

      <!-- Coloring Pencil Decorative Elements -->
      <div class="absolute bottom-0 right-12 dir-rtl:left-12 dir-rtl:right-auto opacity-10 pointer-events-none hidden md:block text-8xl transform rotate-12 translate-y-6">
        ✏️🖍️
      </div>

    </div>

  </div>
</section>
