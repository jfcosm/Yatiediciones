---
---
<section class="relative pt-32 pb-20 md:pt-40 md:pb-28 overflow-hidden bg-gradient-to-b from-hueso via-hueso to-white">
  
  <!-- Decorative background elements -->
  <div class="absolute top-20 right-0 w-72 h-72 bg-ocre/10 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute bottom-10 left-10 w-96 h-96 bg-terracota/5 rounded-full blur-3xl pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-8 items-center">
      
      <!-- Text Column -->
      <div class="space-y-8 text-center lg:text-left order-2 lg:order-1">
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-verde/10 text-verde font-bold text-sm">
          <span class="w-2 h-2 rounded-full bg-verde animate-pulse"></span>
          Región de Coquimbo
        </div>
        
        <h1 class="font-display text-4xl sm:text-5xl lg:text-6xl font-extrabold text-azul leading-tight">
          Yatiediciones: <br class="hidden sm:inline" />
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-terracota to-ocre">
            Libros con identidad y raíces
          </span>
        </h1>
        
        <p class="text-lg sm:text-xl text-azul/80 font-medium max-w-xl mx-auto lg:mx-0 leading-relaxed">
          Conectando a niños y familias con las culturas originarias de Chile a través de historias que se leen, se pintan y se viven.
        </p>
        
        <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4">
          <a 
            href="#catalog" 
            class="w-full sm:w-auto text-center px-8 py-4 bg-terracota text-white font-extrabold rounded-full hover:bg-ocre hover:scale-105 active:scale-95 transition-all shadow-lg shadow-terracota/30 hover:shadow-ocre/30 text-lg"
          >
            Explorar el Catálogo
          </a>
          <a 
            href="#about" 
            class="w-full sm:w-auto text-center px-8 py-4 bg-transparent border-2 border-azul/20 text-azul font-bold rounded-full hover:bg-azul/5 hover:border-azul/40 active:scale-95 transition-all text-lg"
          >
            Conócenos más
          </a>
        </div>

        <!-- Micro stats / Highlights -->
        <div class="grid grid-cols-3 gap-6 pt-6 border-t border-azul/10 max-w-md mx-auto lg:mx-0">
          <div>
            <span class="block text-2xl font-bold font-display text-terracota">100%</span>
            <span class="text-xs text-azul/60 font-bold uppercase tracking-wider">Interactivo</span>
          </div>
          <div>
            <span class="block text-2xl font-bold font-display text-ocre">Coquimbo</span>
            <span class="text-xs text-azul/60 font-bold uppercase tracking-wider">Origen local</span>
          </div>
          <div>
            <span class="block text-2xl font-bold font-display text-verde">Didáctico</span>
            <span class="text-xs text-azul/60 font-bold uppercase tracking-wider">Educación</span>
          </div>
        </div>
      </div>

      <!-- Image Column -->
      <div class="order-1 lg:order-2 flex justify-center">
        <div class="relative w-full max-w-lg lg:max-w-none">
          <!-- Backdrop geometric frame -->
          <div class="absolute inset-0 bg-gradient-to-tr from-ocre to-terracota rounded-[2rem] rotate-3 scale-95 opacity-20 blur-sm"></div>
          
          <!-- Image Wrapper -->
          <div class="relative bg-white p-4 rounded-[2rem] shadow-xl border border-azul/5 transform hover:scale-[1.02] hover:-rotate-1 transition-all duration-500">
            <img 
              src="/images/hero_illustration.png" 
              alt="Ilustración Yatiediciones - Niños coloreando e interactuando bajo el sol andino" 
              class="w-full h-auto object-cover rounded-[1.5rem]"
              loading="eager"
              fetchpriority="high"
            />
            <!-- Badge overlay -->
            <div class="absolute -bottom-4 -left-4 bg-azul text-hueso px-5 py-3 rounded-2xl shadow-lg border border-azul/10 flex items-center gap-3">
              <span class="text-3xl">🎨</span>
              <div class="text-left">
                <span class="block text-xs font-bold uppercase tracking-wider text-ocre">Para colorear</span>
                <span class="block text-sm font-bold font-display">¡Listos para pintar!</span>
              </div>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
  
  <!-- Andean geometric bottom border pattern -->
  <div class="absolute bottom-0 left-0 w-full overflow-hidden h-4 flex">
    <div class="w-full h-full bg-repeat-x opacity-10" style="background-image: url('data:image/svg+xml;utf8,<svg xmlns=%22http://www.w3.org/2000/svg%22 width=%2224%22 height=%2216%22 viewBox=%220 0 24 16%22><polygon points=%2212,0 24,12 12,24 0,12%22 fill=%22%23C15C3D%22/></svg>'); background-size: 24px 16px;"></div>
  </div>
</section>
